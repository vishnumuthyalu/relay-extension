# --- Database --------------------------------------------------------------
# docker compose up -d db  starts Postgres with these credentials.
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Public URL and secrets ----------------------------------------------------
# Where GitHub, browsers and email links reach this server (no trailing slash).
# For local development, a tunnel URL such as https://abc123.ngrok.app.
PUBLIC_URL=http://localhost:3000
# 32+ random characters, e.g. `openssl rand -hex 32`. Signs sessions and email links.
SESSION_SECRET=change-me-to-32-or-more-random-characters

# --- GitHub App (see docs/github-app.md) -----------------------------------------
GITHUB_APP_SLUG=your-relay-app
GITHUB_WEBHOOK_SECRET=changeme
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=changeme

# --- Claude ----------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# Claude-written digests per installation per month; past it, plain digests.
# DIGEST_MONTHLY_CAP=100
# Kill switch: false sends plain digests for everyone and skips Claude entirely.
# CLAUDE_ENABLED=true

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=re_...
FROM_EMAIL=digests@yourdomain.com

# --- Local MCP server (npm run mcp) -------------------------------------------
# The installation the stdio MCP server acts for.
# RELAY_INSTALLATION_ID=12345678

# --- simulate-webhook.js ---------------------------------------------------------
# SIM_INSTALLATION_ID=12345678
# SIM_REPO=acme/test-repo
# SIM_BASE_URL=http://localhost:3000