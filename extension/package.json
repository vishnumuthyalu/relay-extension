{
  "name": "relay-mcp",
  "displayName": "Relay: client updates from your pushes",
  "description": "Adds Relay's MCP server to VS Code so Copilot can map repositories to clients, preview digests and check history.",
  "version": "1.0.0",
  "publisher": "vishnumuthyalu",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishnumuthyalu/relay-extension.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/vishnumuthyalu/relay-extension#readme",
  "bugs": {
    "url": "https://github.com/vishnumuthyalu/relay-extension/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "github",
    "client updates",
    "changelog",
    "claude"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "relay",
        "label": "Relay"
      }
    ],
    "commands": [
      {
        "command": "relay.openDashboard",
        "title": "Relay: Open Dashboard"
      },
      {
        "command": "relay.installApp",
        "title": "Relay: Install GitHub App"
      }
    ],
    "configuration": {
      "title": "Relay",
      "properties": {
        "relay.backendUrl": {
          "type": "string",
          "default": "https://relay-vishnu.fly.dev",
          "markdownDescription": "Base URL of your Relay server. Defaults to the hosted Relay; change it only if you run your own. Relay's MCP server is registered at `<backendUrl>/mcp`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}