{
  "name": "relay-extension",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub webhook service that turns code pushes into plain-English client update emails with Claude",
  "author": "Vishnu Muthyalu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishnumuthyalu/relay-extension.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "relay-mcp": "mcp/stdio.js"
  },
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "dev": "node --watch server.js",
    "dev:worker": "node --watch worker.js",
    "migrate": "node lib/db/migrate.js",
    "test": "jest",
    "lint": "eslint .",
    "mcp": "node mcp/stdio.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node mcp/stdio.js"
  },
  "keywords": [],
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "js-yaml": "^5.4.3",
    "supertest": "^7.2.2"
  }
}
